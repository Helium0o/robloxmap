--[[
	Assetto Corsa track -> Roblox, helper functions (generated by tools/assetto/ac2roblox.py).

	1. Import every file in the "meshes" folder with the 3D Importer (Home > Import 3D, or
	   bulk import in the Asset Manager). Keep the default axes and "File Dimensions: Studs".
	2. Insert the .rbxmx file from the converter (right-click Workspace > Insert from File).
	3. In the command bar (View > Command Bar), with <Folder> being this folder's name:
	     require(workspace.<Folder>.Tools).assemble()        -- position, colour, collision
	     require(workspace.<Folder>.Tools).buildRoad()       -- smooth road along the AI line
	     require(workspace.<Folder>.Tools).buildRoad({ invisible = true })  -- collision only
	     require(workspace.<Folder>.Tools).placeSpawn()      -- spawn on the start line
]]

local Tools = {}

local folder = script.Parent
local Manifest = require(folder.Manifest)

local UP = Vector3.new(0, 1, 0)

-- CFrame looking from `position` to `target` (built from fromMatrix to stay exact).
local function lookAt(position: Vector3, target: Vector3): CFrame
	local look = (target - position).Unit
	local right = look:Cross(UP)
	if right.Magnitude < 1e-6 then
		right = look:Cross(Vector3.new(1, 0, 0))
	end
	right = right.Unit
	return CFrame.fromMatrix(position, right, right:Cross(look), -look)
end

local function style(category: string)
	local s = Manifest.styles[category] or Manifest.styles.building
	return Enum.Material[s.material], Color3.fromRGB(s.color[1], s.color[2], s.color[3]), s.collide
end

local function groupFor(model: Instance, cache, name: string): Instance
	local group = cache[name]
	if not group then
		group = model:FindFirstChild(name)
		if not group then
			group = Instance.new("Folder")
			group.Name = name
			group.Parent = model
		end
		cache[name] = group
	end
	return group
end

-- Finds the imported MeshParts by name, then places, colours and anchors them.
function Tools.assemble(options: { searchIn: Instance?, preciseCollision: boolean? }?)
	local o = options or {}
	local byName = {}
	for _, d in (o.searchIn or workspace):GetDescendants() do
		if d:IsA("MeshPart") and byName[d.Name] == nil then
			byName[d.Name] = d
		end
	end
	local model = workspace:FindFirstChild(Manifest.track)
	if not model then
		model = Instance.new("Model")
		model.Name = Manifest.track
		model.Parent = workspace
	end
	local groups = {}
	local placed, rescaled, reshaped = 0, 0, 0
	local missing = {}
	for _, item in Manifest.objects do
		local part = byName[item.name]
		if part then
			local want = Vector3.new(item.size[1], item.size[2], item.size[3])
			local have = part.Size
			local rx, ry, rz = have.X / want.X, have.Y / want.Y, have.Z / want.Z
			local uniform = math.abs(rx - ry) <= 0.03 * rx and math.abs(rx - rz) <= 0.03 * rx
			if uniform and math.abs(rx - 1) > 0.01 then
				part.Size = want -- imported with the wrong unit (e.g. metres)
				rescaled += 1
			elseif not uniform and math.max(want.X, want.Y, want.Z) > 1 then
				reshaped += 1
			end
			local material, color, collide = style(item.category)
			part.Anchored = true
			part.CFrame = CFrame.new(item.center[1], item.center[2], item.center[3])
			part.Material = material
			part.Color = if item.color then Color3.fromRGB(item.color[1], item.color[2], item.color[3]) else color
			part.CanCollide = collide
			part.CanQuery = collide
			part.CanTouch = false
			if item.invisible then
				part.Transparency = 1
				part.CastShadow = false
			end
			if collide and o.preciseCollision ~= false then
				pcall(function()
					part.CollisionFidelity = Enum.CollisionFidelity.PreciseConvexDecomposition
				end)
			end
			part.Parent = groupFor(model, groups, item.category)
			placed += 1
		else
			table.insert(missing, item.name)
		end
	end
	print(string.format("[%s] placed %d of %d meshes (%d rescaled)", Manifest.track, placed, #Manifest.objects, rescaled))
	if #missing > 0 then
		warn(
			string.format(
				"[%s] %d meshes not found, e.g. %s - import them from the meshes folder first",
				Manifest.track,
				#missing,
				missing[1]
			)
		)
	end
	if reshaped > 0 then
		warn(
			string.format(
				"[%s] %d meshes look rotated; re-import them with the default axis settings",
				Manifest.track,
				reshaped
			)
		)
	end
	return placed, missing
end

export type RoadOptions = {
	invisible: boolean?, -- collision-only road under the visual meshes
	lift: number?, -- raise the surface (studs)
	thickness: number?,
	width: number?, -- used when the AI file has no track widths
	color: Color3?,
}

-- Builds the track surface as smooth anchored parts following the AI racing line.
function Tools.buildRoad(options: RoadOptions?)
	local o: RoadOptions = options or {}
	local line = require(folder.RacingLine)
	assert(line and #line.points >= 2, "this track has no ai/fast_lane.ai")
	local pts = line.points
	local n = #pts
	local thickness = o.thickness or 2
	local lift = o.lift or 0
	local fallbackHalf = (o.width or 40) / 2
	local count = if line.closed then n else n - 1

	local function at(i: number): (Vector3, number, number)
		local p = pts[((i - 1) % n) + 1]
		local left, right = p[4], p[5]
		if left + right < 1 then
			left, right = fallbackHalf, fallbackHalf
		end
		return Vector3.new(p[1], p[2] + lift, p[3]), left, right
	end
	local function flat(v: Vector3): Vector3
		local h = Vector3.new(v.X, 0, v.Z)
		return if h.Magnitude > 1e-6 then h.Unit else Vector3.new(0, 0, -1)
	end
	local function bend(p0: Vector3, p1: Vector3, p2: Vector3, width: number): number
		local d = math.clamp(flat(p1 - p0):Dot(flat(p2 - p1)), -1, 1)
		return width / 2 * math.tan(math.acos(d) / 2) + 0.05
	end

	local previous = workspace:FindFirstChild(Manifest.track .. "_Road")
	if previous then
		previous:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = Manifest.track .. "_Road"
	local parts = 0
	for i = 1, count do
		local a, la, ra = at(i)
		local b, lb, rb = at(i + 1)
		local seg = b - a
		local len = seg.Magnitude
		if len > 0.05 then
			local u = seg / len
			local left, right = (la + lb) / 2, (ra + rb) / 2
			local width = left + right
			local e0 = if i > 1 or line.closed then bend((at(i - 1)), a, b, width) else 0
			local e1 = if i < count or line.closed then bend(a, b, (at(i + 2)), width) else 0
			local side = flat(Vector3.new(-u.Z, 0, u.X))
			local top = a + u * ((len + e1 - e0) / 2) + side * ((right - left) / 2)
			local part = Instance.new("Part")
			part.Name = "Road"
			part.Anchored = true
			part.Size = Vector3.new(width, thickness, len + e0 + e1)
			part.CFrame = lookAt(top, top + u) * CFrame.new(0, -thickness / 2, 0)
			part.Material = Enum.Material.Asphalt
			part.Color = o.color or Color3.fromRGB(46, 46, 52)
			part.TopSurface = Enum.SurfaceType.Smooth
			part.BottomSurface = Enum.SurfaceType.Smooth
			part.CanTouch = false
			if o.invisible then
				part.Transparency = 1
				part.CastShadow = false
			end
			part.Parent = model
			parts += 1
		end
	end
	-- start / finish line
	local s0 = at(1)
	local s1 = at(2)
	local _, l0, r0 = at(1)
	local u = (s1 - s0).Unit
	local startLine = Instance.new("Part")
	startLine.Name = "StartFinish"
	startLine.Anchored = true
	startLine.CanCollide = false
	startLine.CanTouch = false
	startLine.Size = Vector3.new(l0 + r0, 0.2, 3)
	startLine.CFrame = lookAt(s0, s0 + u) * CFrame.new((r0 - l0) / 2, 0.1, 0)
	startLine.Color = Color3.new(1, 1, 1)
	startLine.Material = Enum.Material.Neon
	startLine.Parent = model
	model.Parent = workspace
	print(string.format("[%s] road built from %d parts", Manifest.track, parts))
	return model
end

-- Puts a SpawnLocation on the start line, facing the direction of the racing line.
function Tools.placeSpawn(): SpawnLocation
	local line = require(folder.RacingLine)
	assert(line and #line.points >= 2, "this track has no ai/fast_lane.ai")
	local p0, p1 = line.points[1], line.points[2]
	local a = Vector3.new(p0[1], p0[2] + 3, p0[3])
	local b = Vector3.new(p1[1], p0[2] + 3, p1[3])
	local spawn = workspace:FindFirstChild(Manifest.track .. "_Spawn") or Instance.new("SpawnLocation")
	spawn.Name = Manifest.track .. "_Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = lookAt(a, b)
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = workspace
	return spawn
end

return Tools
